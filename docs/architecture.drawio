        </mxCell>
        <mxCell id="configBody" value="every constant, one place:&#10;&#10;ALLOWED_HOSTS (2)&#10;CONNECT_TIMEOUT 5s&#10;READ_TIMEOUT 15s&#10;WRITE_TIMEOUT 5s&#10;POOL_TIMEOUT 5s&#10;MAX_CONCURRENT_FETCHES 20&#10;MAX_DOWNLOAD_BYTES 5MB&#10;CACHE_TTL 6h&#10;CACHE_MAX_ENTRIES 256&#10;MAX_CONTENT_LENGTH 15k&#10;MAX_INPUT_LENGTH 256&#10;MAX_INCLUDES 16" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontFamily=Consolas;fontColor=#795548;spacingLeft=12;" vertex="1" parent="1">
